# Copy this file to .env and fill in your keys. Never commit .env (it is git-ignored).

# ---------------------------------------------------------------- LLM backend
# Provider: "openai" (OpenAI or any OpenAI-compatible server) or "azure".
MAPAGENT_LLM_PROVIDER=openai

# OpenAI, or an OpenAI-compatible server selected with OPENAI_BASE_URL:
#   OpenRouter (e.g. Qwen-2.5-72B):  OPENAI_BASE_URL=https://openrouter.ai/api/v1  (OPENAI_API_KEY = your OpenRouter key)
#   local vLLM (e.g. Qwen-2.5-VL):   OPENAI_BASE_URL=http://localhost:8000/v1      (OPENAI_API_KEY=EMPTY)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Azure OpenAI (MAPAGENT_LLM_PROVIDER=azure or --provider azure; --model is then the deployment name)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01

# ---------------------------------------------------------------- Google Maps
# The key needs the Places API, Directions API and Geocoding API.
GOOGLE_MAPS_API_KEY=
